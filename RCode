###comparisons across time (and treatment) in 4 h observations periods

my.data <- read.csv("LatencyAndCopulation4h.csv")
str(my.data)
my.data$Treatment <- factor(my.data$Treatment, 
                            levels=c("Control", "Zero", "MinusFour"),
                            labels=c("4°C", "0°C", "-4°C"))
