#Sex   1  0.85383         9     10.605 0.7246 0.4167

##############################################################
##                                                          ##
##                   Inoculative freezing                   ##
##                                                          ##
##############################################################

#####G-test####

#formatting data for test
counts <- read.csv("InoculativeFreezing.csv", stringsAsFactors = FALSE)
str(counts)
#rename columns
colnames(counts) <- c("Temperature", "-3", "-5","-8")
counts
#survival categories in rows
#temperature in columns (compare among temperatures)

#remove first column and add row names instead
#also remove last two rows (handling controls)

cats <- counts$Temperature[1:4]
counts <- counts[1:4,2:4]
rownames(counts) <- cats
counts

#G test
counts <- as.matrix(counts)
GTest(counts, correct="none") 

#       Log likelihood ratio (G-test) test of independence without correction
#data:  counts
#G = 88.632, X-squared df = 6, p-value < 2.2e-16

##############################################################
##                                                          ##
##                     Proportion Mating                    ##
##                                                          ##
##############################################################

#####G-test####

#formatting data for test
counts <- read.csv("ProportionMated.csv", stringsAsFactors = FALSE)
str(counts)
counts
#temperature in rows
#observation dates in columns (compare among observation days)

#remove first column and add row names instead
#also remove last two rows (handling controls)

cats <- counts$Day
counts <- counts[1:3,2:4]
rownames(counts) <- cats
counts

#G test
counts <- as.matrix(counts)
GTest(counts, correct="none") 

#       Log likelihood ratio (G-test) test of independence without correction
#data:  counts
#G = 0.083451, X-squared df = 4, p-value = 0.9992

